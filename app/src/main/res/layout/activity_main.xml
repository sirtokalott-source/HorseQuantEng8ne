<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HORSE QUANT ENGINE v2.0 (AUTONOMOUS)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtAutoScheduleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AUTO-SCAN: 07:30 DAILY | AUTO-AUDIT: +1HR POST-LAST RACE"
            android:textColor="#4CAF50"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:background="#1B5E20"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Extra Sub-Threshold Picks (0 = Pure Core Only):"
                android:textColor="#BDBDBD"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/inputExtraSubPicks"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF9800"
                android:inputType="number"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnScanMarkets"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SCAN TODAY'S MARKETS NOW"
            android:backgroundTint="#FF9800"
            android:textColor="#121212"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CORE ENGINE A QUALIFIERS (RANKED #1 BEST FIRST):"
            android:textColor="#4CAF50"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/containerCorePicks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/txtSubThresholdHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ SUB-THRESHOLD ALTERNATIVES (EXCLUDED FROM MODEL DATA):"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/containerSubPicks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AUTONOMOUS A/B SCOREBOARD &amp; 50-RACE GATE:"
            android:textColor="#03A9F4"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/txtScoreboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Engine A (Champion): Win Rate --% | ROI --%\nEngine B (Challenger): Win Rate --% | ROI --%\n50-Race Sample Gate: 0 / 50 Audited Races"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:padding="12dp"
            android:background="#1E1E1E"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SYSTEM UPDATE &amp; AUDIT LOG:"
            android:textColor="#FF9800"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/txtSystemLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[System Ready] Daily 07:30 Auto-Scan &amp; +1Hr Post-Race Audit Active."
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            android:padding="12dp"
            android:background="#1E1E1E"/>

    </LinearLayout>
</ScrollView>
